# ─── lemu-auth Docker Environment ───────────────────────────────────────────────
# Copy this to .env and fill in your values, or override in docker-compose.yml

PORT=5000

# MongoDB
MONGO_URI=mongodb://mongodb:27017/lemu-auth

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email (Mailtrap / Sendgrid / etc.)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_user
MAIL_PASS=your_pass

# API Key for other services
API_KEY=dev-api-key-change-me

# JWT
JWT_SECRET=dev-jwt-secret-change-me-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000
