# ─── lemu-auth Docker Environment ───────────────────────────────────────────────
# Used by docker-compose.yml from rovio-car-bike-rental
# Replace secrets below before deploying to production.

PORT=5000

# MongoDB
MONGO_URI=mongodb://mongodb:27017/lemu-auth

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=onboarding@resend.dev

# API Key for other services (must match rovio's LEMU_API_KEY)
API_KEY=change-me-to-match-rovio

# JWT (must match rovio's JWT_SECRET)
JWT_SECRET=change-me-to-match-rovio

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000
