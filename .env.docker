# ─── lemu-auth Docker Environment ───────────────────────────────────────────────
# Copy this to .env and fill in your values, or override in docker-compose.yml

PORT=5000

# MongoDB
MONGO_URI=mongodb://mongodb:27017/lemu-auth

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=onboarding@resend.dev

# API Key for other services
API_KEY=dev-api-key-change-me

# JWT
JWT_SECRET=dev-jwt-secret-change-me-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3030
