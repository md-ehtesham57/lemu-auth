PORT=5000

# MongoDB
MONGO_URI=your_mongodb_connection_string_here

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Email (Mailtrap / Sendgrid / etc.)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_user
MAIL_PASS=your_pass

# API Key for other services to consume this auth (service-to-service)
API_KEY=generate_a_random_api_key_for_other_services

# JWT
JWT_SECRET=generate_a_strong_random_secret_at_least_64_chars_long_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000
